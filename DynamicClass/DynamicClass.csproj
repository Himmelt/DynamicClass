<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Himmelt.DynamicClass</PackageId>
    <Authors>Himmelt</Authors>
    <Version>1.2.0</Version>
    <Title>轻量级的C#动态代码编译库</Title>
    <Description>轻量级的C#动态代码编译库</Description>
    <Copyright>Copyright (c) 2025-2026 Himmelt</Copyright>
    <PackageReleaseNotes>运行时闭包引用策略；支持 .NET 8/9/10；动态编译使用 Release 优化；动态编译产物加载到可回收 AssemblyLoadContext，支持卸载以避免内存泄漏。</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/Himmelt/DynamicClass</PackageProjectUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageTags>csharp;dynamic;compile;roslyn;runtime</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Himmelt/DynamicClass.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageIcon>nuget_logo.png</PackageIcon>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DynamicClass.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="nuget_logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
